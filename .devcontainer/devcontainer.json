// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-outside-of-docker
{
	"name": "Thanks Bot Dev Container",
	"image": "mcr.microsoft.com/devcontainers/base:bullseye",

	"features": {
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
			"version": "latest",
			"enableNonRootDocker": "false",
			"moby": "false"
		},
		"ghcr.io/dhoeric/features/google-cloud-cli:1": {
			"installGkeGcloudAuthPlugin": true
		},
		"ghcr.io/postfinance/devcontainer-features/dotnet:1": {
			"version": "10.0",
			"additionalVersions": "8.0,9.0",
			"dotnetRuntimeVersions": "lts, 8.0",
			"aspNetCoreRuntimeVersions": "lts, 8.0",
			"workloads": "wasm-tools"
		}
	},

	"containerEnv": {
		"GOOGLE_APPLICATION_CREDENTIALS": "/workspace/thanks-bot-prod-153b434ab618.json"
	},
  	// Use this environment variable if you need to bind mount your local source code into a new container.
	"remoteEnv": {
		"LOCAL_WORKSPACE_FOLDER": "${localWorkspaceFolder}",
		"GOOGLE_APPLICATION_CREDENTIALS": "${containerWorkspaceFolder}/thanks-bot-prod-153b434ab618.json"
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],
	"postCreateCommand": "dotnet restore"
	// Use 'postCreateCommand' to run commands after the container is created.
	// "postCreateCommand": "docker --version",

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
